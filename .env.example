# DeepSeek API Key — para todo el razonamiento y generación de JCS
# Obtener en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-053c9fd5912543ba8f5a83a5ad6e5dc5

# Modelos DeepSeek (IDs de la API)
# V4 Pro — razonamiento profundo: Fase 1 (entrevista), Fase 2 (diseño), Capa 2 (revisor adversarial)
DEEPSEEK_V4_MODEL="deepseek-reasoner"
# Flash — generación rápida: Fase 3 (generar skill.md + validate.sh), transcripción de audio
DEEPSEEK_FLASH_MODEL="deepseek-chat"

# Base de datos local — SQLite en archivo. Sin Turso cloud.
# No requiere configuración adicional. Se crea automáticamente en raíz del proyecto.
DATABASE_URL="file:local.db"
